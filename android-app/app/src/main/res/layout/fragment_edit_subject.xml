<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
 <TextView android:id="@+id/screenTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/add_subject" android:textColor="@color/text_primary" android:textSize="26sp" android:textStyle="bold"/>
 <com.google.android.material.textfield.TextInputLayout android:id="@+id/nameLayout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:hint="@string/subject_name"><com.google.android.material.textfield.TextInputEditText android:id="@+id/nameInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start|center_vertical" android:imeOptions="actionNext" android:inputType="text|textCapSentences" android:layoutDirection="locale" android:maxLength="80" android:singleLine="true" android:textDirection="locale" android:textLocale="ar-SA"/></com.google.android.material.textfield.TextInputLayout>
 <com.google.android.material.textfield.TextInputLayout android:id="@+id/targetLayout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="@string/weekly_target_hours"><com.google.android.material.textfield.TextInputEditText android:id="@+id/targetInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:singleLine="true"/></com.google.android.material.textfield.TextInputLayout>
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="@string/subject_color" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold"/>
 <RadioGroup android:id="@+id/colorGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><RadioButton android:id="@+id/colorYellow" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:buttonTint="@color/yellow_primary" android:checked="true" android:text="أصفر"/><RadioButton android:id="@+id/colorTiffany" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:buttonTint="@color/tiffany" android:text="تيفاني"/><RadioButton android:id="@+id/colorPink" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:buttonTint="@color/pink_pastel" android:text="وردي"/><RadioButton android:id="@+id/colorPurple" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:buttonTint="@color/purple_pastel" android:text="بنفسجي"/></RadioGroup>
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/subject_sections" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><CheckBox android:id="@+id/theoryCheck" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:checked="true" android:text="@string/theory"/><CheckBox android:id="@+id/practicalCheck" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:checked="true" android:text="@string/practical"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:orientation="horizontal"><com.google.android.material.button.MaterialButton android:id="@+id/saveButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:elevation="8dp" android:text="@string/save" android:textColor="@color/text_primary" app:backgroundTint="@color/yellow_primary" app:cornerRadius="16dp"/><com.google.android.material.button.MaterialButton android:id="@+id/cancelButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_marginStart="12dp" android:layout_weight="1" android:elevation="8dp" android:text="@string/cancel" android:textColor="@color/text_primary" app:backgroundTint="@color/tiffany" app:cornerRadius="16dp"/></LinearLayout>
 <com.google.android.material.button.MaterialButton android:id="@+id/deleteButton" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/delete" android:textColor="@color/error" android:visibility="gone"/>
</LinearLayout></ScrollView>
